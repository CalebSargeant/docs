# Response headers for docs.calebsargeant.com, applied by Cloudflare Workers Static Assets.
#
# MkDocs copies this file to the site root and Cloudflare reads it from there. It is
# authoritative only because wrangler.toml has no `main`: custom headers are NOT applied to
# responses generated by Worker code. GitHub Pages, which served this site before, could
# not set any of these.
#
# The security set matches calebsargeant.com's, except the CSP, which is written for what
# MkDocs Material and these pages actually load (checked in a browser against the built
# site, not copied):
#
#   script-src   Material's inline bootstrap scripts, MathJax from unpkg.com, and the
#                Cloudflare Web Analytics beacon, which the zone injects into every HTML
#                response (allowed by host: the injected URL carries a version after
#                beacon.min.js, which an exact-path source would not match; it reports to
#                /cdn-cgi/rum on this origin, which connect-src 'self' already allows)
#   style-src    Material's inline styles, and the Google Fonts stylesheet
#   font-src     Google Fonts, and the web fonts MathJax fetches from unpkg.com
#   img-src      the site, inline data: URIs, and the lab images still linked from
#                raw.githubusercontent.com (too large to publish, see mkdocs.yml)
#   connect-src  the site (search index, instant navigation) and api.github.com, which
#                Material asks for the repository's stars and forks in the header
#   worker-src   the search worker, served from the site itself
#
# A new external embed on any page needs its origin added here, or it will be blocked
# with nothing but a console error to say so.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://unpkg.com; img-src 'self' data: https://raw.githubusercontent.com; connect-src 'self' https://api.github.com; worker-src 'self' blob:; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Material's own bundles are content-hashed, but docs/assets/ (theme.css, mathjax.js) is
# not, so a day rather than a year: long enough to matter, short enough that a style
# change reaches a returning reader tomorrow.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
